<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ball Battle</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Inter:wght@400;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#0d0d1a;font-family:'Inter',sans-serif}
#ui{position:fixed;top:0;left:0;width:100%;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:10px 20px;background:rgba(0,0,0,0.5);backdrop-filter:blur(8px);border-bottom:1px solid rgba(255,255,255,0.08)}
.sb{display:flex;flex-direction:column;align-items:center;gap:2px}
.pl{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;opacity:0.7}
.sc{font-family:'Orbitron',monospace;font-size:28px;font-weight:900}
.p1l,.p1s{color:#4fc3f7}.p2l,.p2s{color:#ff7043}
.tb{display:flex;flex-direction:column;align-items:center;gap:2px}
.tl{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;opacity:0.7;color:#aaa}
.ti{font-family:'Orbitron',monospace;font-size:28px;font-weight:900;color:#fff}
.ti.urg{color:#ff4444;animation:pulse .5s infinite alternate}
@keyframes pulse{from{opacity:1}to{opacity:.4}}
#cv{display:block;width:100%;height:100%}
.screen{position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(13,13,26,.95);gap:16px;text-align:center;padding:20px}
.screen.hidden{display:none}
.gt{font-family:'Orbitron',monospace;font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:#fff;margin-bottom:8px}
.gt .t1{color:#4fc3f7}.gt .t2{color:#ff7043}
.sub{font-size:14px;color:rgba(255,255,255,.5);max-width:420px;line-height:1.6}
.cg{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:16px 0;max-width:500px;width:100%}
.cc{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:16px}
.ct{font-size:13px;font-weight:600;letter-spacing:1px;margin-bottom:10px}
.ct.p1{color:#4fc3f7}.ct.p2{color:#ff7043}
.cr{display:flex;justify-content:space-between;align-items:center;margin:6px 0}
.cr span:first-child{font-size:12px;color:rgba(255,255,255,.5)}
.ky{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:6px;padding:3px 8px;font-size:12px;font-weight:600;font-family:'Orbitron',monospace;color:#fff;min-width:32px;text-align:center}
.btn{background:#fff;color:#0d0d1a;border:none;border-radius:10px;padding:14px 40px;font-family:'Orbitron',monospace;font-size:14px;font-weight:700;cursor:pointer;transition:all 180ms cubic-bezier(.16,1,.3,1)}
.btn:hover{transform:scale(1.04)}.btn:active{transform:scale(.97)}
.btn.start{background:linear-gradient(135deg,#4fc3f7,#1976d2);color:#fff}
.btn.restart{background:linear-gradient(135deg,#ff7043,#e53935);color:#fff}
.btn.ghost{background:transparent;border:1px solid rgba(255,255,255,.2);color:#fff;margin-top:4px}
.wt{font-family:'Orbitron',monospace;font-size:clamp(1.8rem,5vw,3rem);font-weight:900}
.wt.p1{color:#4fc3f7}.wt.p2{color:#ff7043}.wt.draw{color:#ffd740}
.ws{display:flex;gap:40px;align-items:center;font-family:'Orbitron',monospace;font-size:2.5rem;font-weight:900}
.ws .vs{font-size:1rem;color:rgba(255,255,255,.3);font-weight:400}
</style>
</head>
<body>
<div id="ui">
  <div class="sb"><span class="pl p1l">Giocatore 1</span><span class="sc p1s" id="s1">0</span></div>
  <div class="tb"><span class="tl">Tempo</span><span class="ti" id="ti">60</span></div>
  <div class="sb"><span class="pl p2l">Giocatore 2</span><span class="sc p2s" id="s2">0</span></div>
</div>
<canvas id="cv"></canvas>

<!-- Schermata iniziale -->
<div class="screen" id="ss">
  <div class="gt"><span class="t1">BALL</span> <span class="t2">BATTLE</span></div>
  <p class="sub">Spara le palline contro i mattoni avversari. Chi ne distrugge di piu' in 60 secondi vince!</p>
  <div class="cg">
    <div class="cc">
      <div class="ct p1">Giocatore 1</div>
      <div class="cr"><span>Mira sx</span><span class="ky">A</span></div>
      <div class="cr"><span>Mira dx</span><span class="ky">D</span></div>
      <div class="cr"><span>Spara</span><span class="ky">W</span></div>
    </div>
    <div class="cc">
      <div class="ct p2">Giocatore 2</div>
      <div class="cr"><span>Mira sx</span><span class="ky">&#8592;</span></div>
      <div class="cr"><span>Mira dx</span><span class="ky">&#8594;</span></div>
      <div class="cr"><span>Spara</span><span class="ky">&#8593;</span></div>
    </div>
  </div>
  <button class="btn start" onclick="startGame()">INIZIA PARTITA</button>
</div>

<!-- Schermata fine partita -->
<div class="screen hidden" id="ws">
  <div class="wt" id="wt">PAREGGIO</div>
  <div class="ws">
    <span id="f1" style="color:#4fc3f7">0</span>
    <span class="vs">vs</span>
    <span id="f2" style="color:#ff7043">0</span>
  </div>
  <button class="btn restart" onclick="restartGame()">RIVINCITA</button>
  <button class="btn ghost" onclick="goMenu()">MENU</button>
</div>

<script>
const cv=document.getElementById('cv'),cx=cv.getContext('2d');
const UI=56,BR=10,BS=480,CD=0.5,MB=3,GT=60,AS=2.0;
const P1C='#4fc3f7',P2C='#ff7043';
const C1=['#0277bd','#0288d1','#039be5','#29b6f6'];
const C2=['#bf360c','#d84315','#e64a19','#ff5722'];
let W,H,run=false,gtime=0,sc1=0,sc2=0,lt=0;
let bricks=[],balls=[],parts=[],lnch=[];
let keys={};
document.addEventListener('keydown',e=>{keys[e.code]=true;e.preventDefault()});
document.addEventListener('keyup',e=>keys[e.code]=false);
function resize(){cv.width=W=innerWidth;cv.height=H=innerHeight}
window.addEventListener('resize',()=>{resize();if(run)init();});
resize();

function init(){
  bricks=[];balls=[];parts=[];
  const pH=H-UI,hH=pH/2;
  buildZ(W/2+16,UI+8,W/2-24,hH-16,1);
  buildZ(8,UI+hH+8,W/2-24,hH-16,2);
  lnch=[
    {x:60,y:UI+hH*.5,a:0,cd:0,o:1},
    {x:W-60,y:UI+hH*1.5,a:Math.PI,cd:0,o:2}
  ];
}

function buildZ(zx,zy,zw,zh,o){
  const cols=7,rows=4,mg=8;
  const bw=(zw-mg*(cols+1))/cols,bh=(zh-mg*(rows+1))/rows;
  const clr=o===1?C1:C2;
  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){
    const hp=~~(Math.random()*2)+1;
    bricks.push({x:zx+mg+c*(bw+mg),y:zy+mg+r*(bh+mg),w:bw,h:bh,o,hp,mhp:hp,clr:clr[r%clr.length],sh:0,sx:0,sy:0});
  }
}

function hud(){
  document.getElementById('s1').textContent=sc1;
  document.getElementById('s2').textContent=sc2;
  const t=Math.ceil(gtime),el=document.getElementById('ti');
  el.textContent=t;el.classList.toggle('urg',t<=10);
}

function startGame(){
  document.getElementById('ss').classList.add('hidden');
  sc1=0;sc2=0;gtime=GT;hud();init();
  run=true;lt=performance.now();requestAnimationFrame(loop);
}
function restartGame(){document.getElementById('ws').classList.add('hidden');startGame();}
function goMenu(){document.getElementById('ws').classList.add('hidden');document.getElementById('ss').classList.remove('hidden');run=false;}

function endGame(){
  run=false;
  document.getElementById('f1').textContent=sc1;
  document.getElementById('f2').textContent=sc2;
  const w=document.getElementById('wt');
  if(sc1>sc2){w.textContent='GIOCATORE 1 VINCE!';w.className='wt p1';}
  else if(sc2>sc1){w.textContent='GIOCATORE 2 VINCE!';w.className='wt p2';}
  else{w.textContent='PAREGGIO!';w.className='wt draw';}
  document.getElementById('ws').classList.remove('hidden');
}

function inp(dt){
  const l1=lnch[0],l2=lnch[1];
  if(keys['KeyA'])l1.a-=AS*dt;
  if(keys['KeyD'])l1.a+=AS*dt;
  if(keys['KeyW']&&l1.cd<=0){shoot(l1);l1.cd=CD;}
  if(keys['ArrowLeft'])l2.a-=AS*dt;
  if(keys['ArrowRight'])l2.a+=AS*dt;
  if(keys['ArrowUp']&&l2.cd<=0){shoot(l2);l2.cd=CD;}
  l1.a=Math.max(-Math.PI*.75,Math.min(Math.PI*.75,l1.a));
  l2.a=Math.max(Math.PI*.25,Math.min(Math.PI*1.75,l2.a));
  for(const l of lnch)l.cd=Math.max(0,l.cd-dt);
}

function shoot(l){
  if(balls.filter(b=>b.o===l.o).length>=MB)return;
  balls.push({x:l.x+Math.cos(l.a)*30,y:l.y+Math.sin(l.a)*30,
    vx:Math.cos(l.a)*BS,vy:Math.sin(l.a)*BS,o:l.o,r:BR,tr:[],lf:12});
  sfx(l.o===1?440:330,.08,'sine');
}

function crc(b,r){
  const nx=Math.max(r.x,Math.min(b.x,r.x+r.w)),ny=Math.max(r.y,Math.min(b.y,r.y+r.h));
  const dx=b.x-nx,dy=b.y-ny;return dx*dx+dy*dy<b.r*b.r;
}

function upd(dt){
  inp(dt);
  for(let i=balls.length-1;i>=0;i--){
    const b=balls[i];
    b.tr.push({x:b.x,y:b.y});if(b.tr.length>10)b.tr.shift();
    b.x+=b.vx*dt;b.y+=b.vy*dt;
    if(b.x-b.r<0){b.x=b.r;b.vx=Math.abs(b.vx);}
    if(b.x+b.r>W){b.x=W-b.r;b.vx=-Math.abs(b.vx);}
    if(b.y-b.r<UI){b.y=UI+b.r;b.vy=Math.abs(b.vy);}
    if(b.y+b.r>H){b.y=H-b.r;b.vy=-Math.abs(b.vy);}
    for(let j=bricks.length-1;j>=0;j--){
      const br=bricks[j];
      if(crc(b,br)){
        const oL=b.x-br.x,oR=br.x+br.w-b.x,oT=b.y-br.y,oB=br.y+br.h-b.y;
        const m=Math.min(oL,oR,oT,oB);
        if(m===oL||m===oR)b.vx*=-1;else b.vy*=-1;
        br.hp--;br.sh=.15;br.sx=(Math.random()-.5)*8;br.sy=(Math.random()-.5)*8;
        sfx(200+Math.random()*100,.06,'square');
        if(br.hp<=0){
          if(b.o===1)sc1++;else sc2++;
          spwn(br.x+br.w/2,br.y+br.h/2,br.clr,12);
          bricks.splice(j,1);hud();
        }
        break;
      }
    }
    b.lf-=dt;if(b.lf<=0)balls.splice(i,1);
  }
  for(const br of bricks)br.sh=Math.max(0,br.sh-dt*4);
  for(let i=parts.length-1;i>=0;i--){
    const p=parts[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=200*dt;p.lf-=dt;
    if(p.lf<=0)parts.splice(i,1);
  }
  gtime-=dt;
  if(gtime<=0){gtime=0;hud();endGame();}else hud();
}

function spwn(x,y,c,n){
  for(let i=0;i<n;i++){
    const a=Math.random()*Math.PI*2,sp=60+Math.random()*180;
    parts.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-80,c,sz:3+Math.random()*4,lf:.3+Math.random()*.5,ml:.8});
  }
}

let actx;
document.addEventListener('keydown',()=>{if(!actx)actx=new(window.AudioContext||window.webkitAudioContext)();},{once:true});
function sfx(f,d,t){
  if(!actx)return;
  const o=actx.createOscillator(),g=actx.createGain();
  o.type=t;o.frequency.value=f;
  g.gain.setValueAtTime(.18,actx.currentTime);
  g.gain.exponentialRampToValueAtTime(.001,actx.currentTime+d);
  o.connect(g).connect(actx.destination);o.start();o.stop(actx.currentTime+d);
}

function rrect(x,y,w,h,r){
  cx.beginPath();cx.moveTo(x+r,y);cx.lineTo(x+w-r,y);
  cx.quadraticCurveTo(x+w,y,x+w,y+r);cx.lineTo(x+w,y+h-r);
  cx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);cx.lineTo(x+r,y+h);
  cx.quadraticCurveTo(x,y+h,x,y+h-r);cx.lineTo(x,y+r);
  cx.quadraticCurveTo(x,y,x+r,y);cx.closePath();
}

function draw(){
  cx.clearRect(0,0,W,H);
  const gr=cx.createLinearGradient(0,UI,0,H);
  gr.addColorStop(0,'#0d0d1a');gr.addColorStop(1,'#12122a');
  cx.fillStyle=gr;cx.fillRect(0,UI,W,H-UI);
  const HF=W/2,MY=UI+(H-UI)/2;
  cx.save();cx.strokeStyle='rgba(255,255,255,.06)';cx.lineWidth=1;cx.setLineDash([8,12]);
  cx.beginPath();cx.moveTo(HF,UI);cx.lineTo(HF,H);cx.stroke();
  cx.beginPath();cx.moveTo(0,MY);cx.lineTo(W,MY);cx.stroke();
  cx.setLineDash([]);cx.restore();

  // Mattoni
  for(const br of bricks){
    const sx=br.sh>0?br.sx*br.sh:0,sy=br.sh>0?br.sy*br.sh:0,hr=br.hp/br.mhp;
    cx.save();cx.translate(br.x+sx,br.y+sy);
    cx.shadowBlur=12;cx.shadowColor=br.clr;cx.globalAlpha=.3+hr*.7;
    cx.fillStyle=br.clr;rrect(0,0,br.w,br.h,6);cx.fill();
    cx.globalAlpha=.5+hr*.5;cx.shadowBlur=0;
    cx.strokeStyle='rgba(255,255,255,.25)';cx.lineWidth=1;cx.stroke();
    if(br.mhp>1){
      cx.globalAlpha=1;cx.fillStyle='rgba(255,255,255,.9)';
      cx.font=`bold ${Math.max(10,br.h*.4)}px Inter,sans-serif`;
      cx.textAlign='center';cx.textBaseline='middle';cx.shadowBlur=0;
      cx.fillText(br.hp,br.w/2,br.h/2);
    }
    cx.restore();
  }

  // Palle
  for(const b of balls){
    const col=b.o===1?P1C:P2C;
    for(let i=0;i<b.tr.length;i++){
      const t=b.tr[i],a=(i/b.tr.length)*.35,r=b.r*(i/b.tr.length)*.7;
      cx.save();cx.globalAlpha=a;cx.fillStyle=col;
      cx.beginPath();cx.arc(t.x,t.y,r,0,Math.PI*2);cx.fill();cx.restore();
    }
    cx.save();cx.shadowBlur=20;cx.shadowColor=col;cx.fillStyle=col;
    cx.beginPath();cx.arc(b.x,b.y,b.r,0,Math.PI*2);cx.fill();
    cx.shadowBlur=0;cx.fillStyle='rgba(255,255,255,.5)';
    cx.beginPath();cx.arc(b.x-b.r*.3,b.y-b.r*.3,b.r*.3,0,Math.PI*2);cx.fill();
    cx.restore();
  }

  // Lanciatori
  for(const l of lnch){
    const col=l.o===1?P1C:P2C,cdR=l.cd/CD;
    cx.save();cx.translate(l.x,l.y);
    cx.shadowBlur=16;cx.shadowColor=col;
    cx.fillStyle='rgba(0,0,0,.5)';cx.beginPath();cx.arc(0,0,22,0,Math.PI*2);cx.fill();
    cx.strokeStyle=col;cx.lineWidth=2.5;cx.stroke();
    if(cdR>0){
      cx.shadowBlur=0;cx.strokeStyle='rgba(255,255,255,.3)';cx.lineWidth=3;
      cx.beginPath();cx.arc(0,0,26,-Math.PI/2,-Math.PI/2+(1-cdR)*Math.PI*2);cx.stroke();
    }
    cx.shadowBlur=8;cx.strokeStyle=col;cx.lineWidth=5;cx.lineCap='round';
    cx.beginPath();cx.moveTo(Math.cos(l.a)*10,Math.sin(l.a)*10);
    cx.lineTo(Math.cos(l.a)*28,Math.sin(l.a)*28);cx.stroke();
    cx.restore();
    cx.save();cx.fillStyle=col;cx.font='600 11px Inter,sans-serif';
    cx.textAlign='center';cx.globalAlpha=.7;cx.fillText(`P${l.o}`,l.x,l.y+40);cx.restore();
  }

  // Particelle
  for(const p of parts){
    const a=p.lf/p.ml;
    cx.save();cx.globalAlpha=a;cx.fillStyle=p.c;cx.shadowBlur=6;cx.shadowColor=p.c;
    cx.fillRect(p.x-p.sz/2,p.y-p.sz/2,p.sz,p.sz);cx.restore();
  }
}

function loop(ts){
  if(!run)return;
  const dt=Math.min((ts-lt)/1000,.05);lt=ts;
  upd(dt);draw();requestAnimationFrame(loop);
}
resize();draw();
</script>
</body>
</html>
